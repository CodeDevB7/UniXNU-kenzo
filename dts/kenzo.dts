/dts-v1/;
/include/ "msm8956.dtsi"

/ {
    model = "Xiaomi Redmi Note 3 (kenzo)";
    compatible = "xiaomi,kenzo", "qcom,msm8956";

    memory@80000000 {
        device_type = "memory";
        // Captured unit: base 0x80000000, 2 GiB address range.
        reg = <0x0 0x80000000 0x0 0x80000000>;
    };

    chosen {
        bootargs = "-v serial=3";
        stdout-path = "/soc/serial@78b0000";
    };

    soc {
        sdhci: sdhci@7824900 {
            unixnu,adt-name = "sdhci";
            compatible = "unixnu,sdhci-block", "qcom,sdhci-msm";
            reg = <0x07824900 0x500>,
                  <0x07824000 0x800>;
            status = "okay";
        };
    };
};
